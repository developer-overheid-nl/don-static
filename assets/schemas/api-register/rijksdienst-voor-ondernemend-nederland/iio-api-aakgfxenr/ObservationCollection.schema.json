{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/rijksdienst-voor-ondernemend-nederland/iio-api-aakgfxenr/observationcollection",
  "x-derived-from": [
    "https://internationaal.ondernemen.overheid.nl/api/iio/v1/openapi.yaml#/components/schemas/ObservationCollection"
  ],
  "description": "A collection schema for the Observation schema.",
  "properties": {
    "observaties": {
      "description": "A list of countries.",
      "type": "array",
      "items": {
        "description": "An observation (measurement) of a country.",
        "required": [
          "id",
          "type",
          "meeteenheid",
          "waarde",
          "jaartal",
          "ranking",
          "schatting",
          "schaal",
          "herkomst"
        ],
        "properties": {
          "herkomst": {
            "required": [
              "bron",
              "datum"
            ],
            "properties": {
              "bron": {
                "required": [
                  "naam"
                ],
                "properties": {
                  "naam": {
                    "description": "The origin of the observation.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "examples": [
                      "Wereldbank"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "datum": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "examples": [
                  "2022-12-01"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "description": "A unique identifier in UUID format from a sector, country, content-item etc.",
            "type": "string",
            "format": "uuid"
          },
          "jaartal": {
            "description": "The year of the observation.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "2016"
            ]
          },
          "landen": {
            "description": "A list of countries related to the current country observation.",
            "type": "array",
            "items": {
              "$ref": "./Country.schema.json"
            }
          },
          "meeteenheid": {
            "required": [
              "naam",
              "afkorting"
            ],
            "properties": {
              "afkorting": {
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "<p>In km²</p>"
                ]
              },
              "naam": {
                "description": "The measuring unit.",
                "type": [
                  "string",
                  "null"
                ],
                "examples": [
                  "Vierkante kilometer"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "ranking": {
            "description": "The ranking of the observation.",
            "type": [
              "integer",
              "null"
            ],
            "examples": [
              5
            ]
          },
          "schaal": {
            "description": "The scale of the observation.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "km²"
            ]
          },
          "schatting": {
            "description": "If this observation is an estimation.",
            "type": [
              "boolean",
              "null"
            ],
            "examples": [
              false
            ]
          },
          "type": {
            "description": "The type of the observation.",
            "type": "string",
            "enum": [
              "bigMacIndex",
              "economischeGroei",
              "easeOfDoingBusinessIndex",
              "uitvoerwaarde",
              "corruptieIndex",
              "bbp",
              "koopkracht",
              "globalCompetitivenessIndex",
              "globalInnovationIndex",
              "invoerWaarde",
              "inflatie",
              "logisticPerformanceIndex",
              "inwoneraantal",
              "oppervlakte",
              "werkloosheid"
            ],
            "examples": [
              "oppervlakte"
            ]
          },
          "waarde": {
            "description": "The amount of the observation.",
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "1671000"
            ]
          }
        },
        "type": [
          "object",
          "null"
        ]
      }
    }
  },
  "type": "object"
}
