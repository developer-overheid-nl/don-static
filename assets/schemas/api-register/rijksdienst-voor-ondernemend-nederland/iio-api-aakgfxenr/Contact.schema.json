{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/rijksdienst-voor-ondernemend-nederland/iio-api-aakgfxenr/contact",
  "x-derived-from": [
    "https://internationaal.ondernemen.overheid.nl/api/iio/v1/openapi.yaml#/components/schemas/Contact"
  ],
  "description": "Contact details of an organization.",
  "properties": {
    "contactpunten": {
      "description": "The points of contact.",
      "type": "array",
      "items": {
        "$ref": "./PointsOfContact.schema.json"
      }
    },
    "geometrie": {
      "description": "The coordinates of this organization.",
      "type": "array",
      "items": {
        "$ref": "./Geometry.schema.json"
      }
    },
    "homepage": {
      "description": "The website of the contact.",
      "type": "string",
      "format": "uri",
      "examples": [
        "https://www.rvo.nl"
      ]
    },
    "id": {
      "description": "A unique identifier in UUID format from a sector, country, content-item etc.",
      "type": "string",
      "format": "uuid"
    },
    "landen": {
      "description": "A list of countries related to the current contact.",
      "type": "array",
      "items": {
        "$ref": "./Country.schema.json"
      }
    },
    "naam": {
      "description": "The name of the contact.",
      "type": "string",
      "examples": [
        "RVO headquarters"
      ]
    },
    "vestiging": {
      "$ref": "./Vestiging.schema.json"
    }
  },
  "type": "object"
}
