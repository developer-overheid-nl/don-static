{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/rijksdienst-voor-ondernemend-nederland/iio-api-aakgfxenr/city",
  "x-derived-from": [
    "https://internationaal.ondernemen.overheid.nl/api/iio/v1/openapi.yaml#/components/schemas/City"
  ],
  "description": "A city is a geographic region and can be the capital of a country.",
  "properties": {
    "id": {
      "description": "A unique identifier in UUID format from a sector, country, content-item etc.",
      "type": "string",
      "format": "uuid"
    },
    "naam": {
      "description": "The name of the city.",
      "type": "string",
      "examples": [
        "Amsterdam"
      ]
    },
    "tijdsverschil": {
      "description": "The time difference in UTC/GMT of the city compared to the Netherlands.",
      "type": "number",
      "format": "float",
      "examples": [
        2
      ]
    }
  },
  "type": "object"
}
