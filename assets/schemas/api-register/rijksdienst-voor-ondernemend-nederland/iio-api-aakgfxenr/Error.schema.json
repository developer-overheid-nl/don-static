{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/rijksdienst-voor-ondernemend-nederland/iio-api-aakgfxenr/error",
  "x-derived-from": [
    "https://internationaal.ondernemen.overheid.nl/api/iio/v1/openapi.yaml#/components/schemas/Error"
  ],
  "description": "An error response schema.",
  "required": [
    "status",
    "title",
    "detail"
  ],
  "properties": {
    "detail": {
      "description": "The details of the error.",
      "type": "string",
      "examples": [
        "The resource with UUID 3fa85f64-5717-4562-b3fc-2c963f66afa6 could not be found."
      ]
    },
    "status": {
      "description": "The HTTP status code of the error.",
      "type": "integer",
      "examples": [
        404
      ]
    },
    "title": {
      "description": "The title of the error.",
      "type": "string",
      "examples": [
        "Not Found"
      ]
    }
  },
  "type": "object"
}
