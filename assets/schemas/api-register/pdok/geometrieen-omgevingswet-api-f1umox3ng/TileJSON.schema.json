{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/pdok/geometrieen-omgevingswet-api-f1umox3ng/tilejson",
  "x-derived-from": [
    "https://api.pdok.nl/omgevingswet/omgevingsdocumenten/ogc/v2/openapi.json#/components/schemas/tileJSON"
