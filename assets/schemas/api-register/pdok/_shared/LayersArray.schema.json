{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/pdok/_shared/layersarray",
  "x-derived-from": [
    "https://api.pdok.nl/brt/top10nl/ogc/v1/openapi.json#/components/schemas/layers-array",
    "https://api.pdok.nl/kadaster/bestuurlijkegebieden/ogc/v1/openapi.json#/components/schemas/layers-array",
    "https://api.pdok.nl/kadaster/brk-kadastrale-kaart/ogc/v1/openapi.json#/components/schemas/layers-array",
    "https://api.pdok.nl/kadaster/brt-achtergrondkaart/ogc/v1/openapi.json#/components/schemas/layers-array",
    "https://api.pdok.nl/lv/bag/ogc/v1-demo/openapi.json#/components/schemas/layers-array",
    "https://api.pdok.nl/lv/bag/ogc/v1/openapi.json#/components/schemas/layers-array",
