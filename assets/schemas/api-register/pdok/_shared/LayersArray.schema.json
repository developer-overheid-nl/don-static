  ],
  "properties": {
    "id": {
      "type": "string",
      "examples": [
        "1"
      ]
    },
    "layout": {
      "type": "object"
    },
    "paint": {
      "$ref": "./Paint.schema.json"
    },
    "source": {
      "type": "string",
      "examples": [
        "daraa"
      ]
    },
    "source-layer": {
      "type": "string",
      "examples": [
