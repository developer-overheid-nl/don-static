{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/pdok/_shared/mbstyle",
  "x-derived-from": [
    "https://api.pdok.nl/brt/top10nl/ogc/v1/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/kadaster/bestuurlijkegebieden/ogc/v1/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/kadaster/brk-kadastrale-kaart/ogc/v1/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/kadaster/brt-achtergrondkaart/ogc/v1/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/lv/bag/ogc/v1-demo/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/lv/bag/ogc/v1/openapi.json#/components/schemas/mb-style",
    "https://api.pdok.nl/lv/bgt/ogc/v1/openapi.json#/components/schemas/mb-style"
  ],
  "properties": {
    "glyphs": {
      "type": "string",
      "examples": [
        "http://fonts.openmaptiles.org/{fontstack}/{range}.pbf"
      ]
    },
    "layers": {
      "items": {
        "$ref": "./LayersArray.schema.json"
      },
      "type": "array"
    },
    "name": {
      "type": "string",
      "examples": [
        "night"
      ]
    },
    "sources": {
      "$ref": "./Sources.schema.json"
    },
    "sprite": {
      "type": "string",
      "examples": [
        "http://vtp2018.s3-eu-west-1.amazonaws.com/static/mapstorestyle/sprites/sprites"
      ]
    },
    "version": {
      "type": "number",
      "examples": [
        8
      ]
    }
  },
  "required": [
    "layers",
    "sources",
    "version"
  ],
  "type": "object"
}
