{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/gemeente-epe/woo-ctnyjxehr/publicatie",
  "x-derived-from": [
    "https://raw.githubusercontent.com/CommonGateway/WooBundle/main/docs/openapi.json#/components/schemas/Publicatie"
  ],
  "type": "object",
  "title": "Publicatie",
  "properties": {
    "beschrijving": {
      "type": [
        "string",
        "null"
      ]
    },
    "bijlagen": {
      "type": "array",
      "items": {
        "$ref": "./Bijlage.schema.json"
      }
    },
    "categorie": {
      "type": [
        "string",
        "null"
      ]
    },
    "gepubliceerd": {
      "type": "boolean",
      "default": true
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "$ref": "./Metadata.schema.json"
    },
    "organisatie": {
      "$ref": "./Organisatie.schema.json"
    },
    "portalUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "url"
    },
    "publicatiedatum": {
      "type": [
        "string",
        "null"
      ],
      "description": "Publicatiedatum van een Woo object is nooit in de toekomst."
    },
    "samenvatting": {
      "type": [
        "string",
        "null"
      ]
    },
    "themas": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "./Thema.schema.json"
      }
    },
    "titel": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "categorie",
    "publicatiedatum"
  ]
}
