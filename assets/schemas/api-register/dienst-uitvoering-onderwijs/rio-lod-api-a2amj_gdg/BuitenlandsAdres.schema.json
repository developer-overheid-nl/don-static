{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/dienst-uitvoering-onderwijs/rio-lod-api-a2amj_gdg/buitenlandsadres",
  "x-derived-from": [
    "https://lod.onderwijsregistratie.nl/rio-api/assets/RIO_LOD_API_v2.yml#/components/schemas/BuitenlandsAdres"
  ],
  "x-class-extra-annotation": "@Relation(collectionRelation = \"Contactadressen\")",
  "type": "object",
  "required": [
    "adresregelEen",
    "landcode",
    "type"
  ],
  "properties": {
    "adresregelDrie": {
      "type": "string",
      "description": "Een regel voor een of meerdere elementen van een adres buiten Nederland.",
      "minLength": 1,
      "maxLength": 80
    },
    "adresregelEen": {
      "type": "string",
      "description": "Een regel voor een of meerdere elementen van een adres buiten Nederland.",
      "minLength": 1,
      "maxLength": 80
    },
    "adresregelTwee": {
      "type": "string",
      "description": "Een regel voor een of meerdere elementen van een adres buiten Nederland.",
      "minLength": 1,
      "maxLength": 80
    },
    "landcode": {
      "type": "string",
      "description": "De code van een land in de tabel 34 van de Rijkdienst voor Identiteitsgegevens.",
      "minLength": 4,
      "maxLength": 4,
      "pattern": "\\d{4,4}"
    },
    "type": {
      "type": "string",
      "description": "Geeft aan wat voor soort Contactadres het betreft.",
      "enum": [
        "BEZOEKBTL",
        "BEZOEKNL",
        "CONTACTPUNT",
        "EMAIL",
        "FAX",
        "POSTNL",
        "POSTBTL",
        "TELEFOON",
        "WEB"
      ]
    }
  }
}
