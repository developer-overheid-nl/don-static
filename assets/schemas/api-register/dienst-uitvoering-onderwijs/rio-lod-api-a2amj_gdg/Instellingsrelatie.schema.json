{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/dienst-uitvoering-onderwijs/rio-lod-api-a2amj_gdg/instellingsrelatie",
  "x-derived-from": [
    "https://lod.onderwijsregistratie.nl/rio-api/assets/RIO_LOD_API_v2.yml#/components/schemas/Instellingsrelatie"
  ],
  "x-class-extra-annotation": "@Relation(collectionRelation = \"Instellingsrelaties\")",
  "required": [
    "begindatum",
    "naarErkenning",
    "soort",
    "vanErkenning"
  ],
  "type": "object",
  "properties": {
    "begindatum": {
      "type": "string",
      "description": "De datum die het begin van de periode aangeeft (inclusief).",
      "format": "date"
    },
    "einddatum": {
      "type": "string",
      "description": "De datum die het einde van de periode aangeeft (exclusief).",
      "format": "date"
    },
    "naarErkenning": {
      "maxLength": 22,
      "minLength": 1,
      "type": "string",
      "description": "Is een identificerend kenmerk van een erkenning van een organisatie of een locatie ten behoeve van uitwisseling in de keten. "
    },
    "soort": {
      "type": "string",
      "description": "Mogelijke relatiesoorten tussen erkende organisaties",
      "enum": [
        "DISLOCATIE",
        "HIERARCHISCH",
        "ONDERSTEUNING",
        "OVERGANG_GEDEELTELIJK",
        "OVERGANG_VOLLEDIG",
        "SAMENWERKING",
        "VERZELFSTANDIGING",
        "VRIJWILLIGE_DEELNAME"
      ]
    },
    "vanErkenning": {
      "maxLength": 22,
      "minLength": 1,
      "type": "string",
      "description": "Is een identificerend kenmerk van een erkenning van een organisatie of een locatie ten behoeve van uitwisseling in de keten. "
    }
  }
}
