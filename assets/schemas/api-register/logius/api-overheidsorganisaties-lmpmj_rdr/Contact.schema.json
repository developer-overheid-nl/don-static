{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/logius/api-overheidsorganisaties-lmpmj_rdr/contact",
  "x-derived-from": [
    "https://api-organisaties.overheid.nl/v1/openapi.json#/components/schemas/Contact"
  ],
  "properties": {
    "contactformulieren": {
      "items": {
        "properties": {
          "label": {
            "examples": [
              "Algemeen"
            ]
          },
          "taalcode": {
            "examples": [
              "nl-NL"
            ]
          },
          "url": {
            "maxLength": 5000,
            "examples": [
              "https://www.vallei-veluwe.nl/over-ons/contact"
            ]
          }
        },
        "required": [
          "label",
          "taalcode"
        ]
      }
    },
    "emailadressen": {
      "items": {
        "properties": {
          "email": {
            "maxLength": 250,
            "examples": [
              "info@vallei-veluwe.nl"
            ]
          },
          "label": {
            "maxLength": 25,
            "examples": [
              "algemeen"
            ]
          }
        },
        "required": [
          "email"
        ]
      }
    },
    "fax": {
      "maxLength": 50,
      "examples": [
        "(055) 527 26 00"
      ]
    },
    "internetadressen": {
      "items": {
        "properties": {
          "label": {
            "maxLength": 25,
            "examples": [
              "algemeen"
            ]
          },
          "url": {
            "maxLength": 5000,
            "examples": [
              "https://www.vallei-veluwe.nl"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "socialmedia": {
      "items": {
        "properties": {
          "gebruikersnaam": {
            "maxLength": 255,
            "examples": [
              "valleienveluwe"
            ]
          },
          "platform": {
            "maxLength": 255,
            "examples": [
              "Facebook"
            ]
          },
          "url": {
            "maxLength": 5000,
            "examples": [
              "https://nl-nl.facebook.com/valleienveluwe"
            ]
          }
        },
        "required": [
          "gebruikersnaam",
          "platform",
          "url"
        ]
      }
    },
    "telefoonnummers": {
      "items": {
        "properties": {
          "label": {
            "maxLength": 25,
            "examples": [
              "algemeen"
            ]
          },
          "nummer": {
            "maxLength": 50,
            "examples": [
              "(055) 527 26 00"
            ]
          }
        },
        "required": [
          "nummer"
        ]
      }
    }
  }
}
