{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/logius/api-overheidsorganisaties-lmpmj_rdr/identificatiecoderecord",
  "x-derived-from": [
    "https://api-organisaties.overheid.nl/v1/openapi.json#/components/schemas/IdentificatiecodeRecord"
  ],
  "properties": {
    "atu": {
      "examples": [
        "http://publications.europa.eu/resource/authority/atu/NLD_GEM_OWI"
      ]
    },
    "btwNummer": {
      "pattern": "^NL\\d{9}B\\d{2}$",
      "examples": [
        "NL817660665B01"
      ]
    },
    "ictuCode": {
      "examples": [
        "04010"
      ]
    },
    "kvkNummer": {
      "pattern": "^\\d{8}$",
      "examples": [
        "51115395"
      ]
    },
    "label": {
      "minLength": 1,
      "examples": [
        "Streekarchivariaat de Liemers en Doesburg"
      ]
    },
    "loonheffingenNummer": {
      "pattern": "^\\d{9}L\\d{2}$",
      "examples": [
        "817660665L01"
      ]
    },
    "oin": {
      "maxLength": 20,
      "examples": [
        "00000001001721951000"
      ]
    },
    "organisatiecode": {
      "pattern": "^col[0-9]{2}$|^gm[0-9]{4}$|^mnre[0-9]{4}$|^oorg[0-9]{5}$|^pv[0-9]{2}$|^so[0-9]{4}$|^zb[0-9]{6}$",
      "examples": [
        "so0263"
      ]
    },
    "owmsId": {
      "description": "Lijst van owms",
      "items": {
        "pattern": "^http://standaarden\\.overheid\\.nl/owms/terms/[^/]+$"
      }
    },
    "rsin": {
      "pattern": "^\\d{9}$",
      "examples": [
        "04010"
      ]
    },
    "systeemId": {
      "minLength": 1,
      "examples": [
        "28772572"
      ]
    },
    "uri": {
      "pattern": "^https://identifier\\.overheid\\.nl/tooi/id/(col/col[0-9]{2}|gemeente/gm[0-9]{4}|ministerie/mnre[0-9]{4}|oorg/oorg[0-9]{5}|provincie/pv[0-9]{2}|so/so[0-9]{4}|waterschap/ws[0-9]{4}|zbo/zb[0-9]{6})$",
      "examples": [
        "https://identifier.overheid.nl/tooi/id/so/so1082"
      ]
    }
  },
  "required": [
    "label",
    "systeemId"
  ]
}
