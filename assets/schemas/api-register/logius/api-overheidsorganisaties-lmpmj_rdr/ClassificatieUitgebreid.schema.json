{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/logius/api-overheidsorganisaties-lmpmj_rdr/classificatieuitgebreid",
  "x-derived-from": [
    "https://api-organisaties.overheid.nl/v1/openapi.json#/components/schemas/ClassificatieUitgebreid"
  ],
  "description": "Classificatie uitgebreid",
  "properties": {
    "classificaties": {
      "description": "Lijst van classificaties",
      "items": {
        "description": "Classificatie",
        "properties": {
          "eindDatum": {
            "format": "date"
          },
          "grondslagen": {
            "description": "Lijst van grondslagen",
            "items": {
              "description": "Grondslag",
              "properties": {
                "opschrift": {
                  "description": "Omschrijving van de grondslag",
                  "examples": [
                    "Waterschappen (Artikel 1.2, lid 1d, WNT)"
                  ]
                },
                "referentie": {
                  "description": "URL-referentie naar het wetsartikel",
                  "examples": [
                    "http://wetten.overheid.nl/jci1.3:c:BWBR0032249&paragraaf=1&artikel=1.2&lid=1"
                  ]
                }
              },
              "required": [
                "opschrift",
                "referentie"
              ]
            }
          },
          "startDatum": {
            "format": "date",
            "examples": [
              "2006-11-11"
            ]
          },
          "toelichting": {
            "examples": [
              "Een website voor toelichting, enz"
            ]
          },
          "type": {
            "examples": [
              "WNT-instelling"
            ]
          },
          "url": {
            "examples": [
              "https://simpel.presurf.web"
            ]
          }
        },
        "required": [
          "grondslagen",
          "type"
        ]
      }
    },
    "label": {
      "examples": [
        "Ministerie van Algemene Zaken"
      ]
    },
    "type": {
      "description": "Lijst van mogelijke TOOI definities",
      "enum": [
        "https://identifier.overheid.nl/tooi/def/ont/CaribischOpenbaarLichaam",
        "https://identifier.overheid.nl/tooi/def/ont/Gemeente",
        "https://identifier.overheid.nl/tooi/def/ont/Ministerie",
        "https://identifier.overheid.nl/tooi/def/ont/Overheidsorganisatie",
        "https://identifier.overheid.nl/tooi/def/ont/Provincie",
        "https://identifier.overheid.nl/tooi/def/ont/Rijk",
        "https://identifier.overheid.nl/tooi/def/ont/Samenwerkingsorganisatie",
        "https://identifier.overheid.nl/tooi/def/ont/Waterschap",
        "https://identifier.overheid.nl/tooi/def/ont/Zbo",
        "https://identifier.overheid.nl/tooi/def/ont/ZboCluster"
      ],
      "examples": [
        "https://identifier.overheid.nl/tooi/def/ont/Ministerie"
      ]
    },
    "uri": {
      "examples": [
        "https://identifier.overheid.nl/tooi/id/ministerie/mnre1010"
      ]
    }
  },
  "required": [
    "classificaties"
  ]
}
