{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/logius/api-overheidsorganisaties-lmpmj_rdr/adres",
  "x-derived-from": [
    "https://api-organisaties.overheid.nl/v1/openapi.json#/components/schemas/Adres"
  ],
  "properties": {
    "adresType": {
      "maxLength": 250,
      "examples": [
        "Bezoekadres"
      ]
    },
    "antwoordnummer": {
      "maxLength": 50,
      "examples": [
        "12345"
      ]
    },
    "huisnummer": {
      "maxLength": 50,
      "examples": [
        "11"
      ]
    },
    "land": {
      "maxLength": 250,
      "examples": [
        "Nederland"
      ]
    },
    "openbareRuimte": {
      "maxLength": 50,
      "minLength": 1,
      "examples": [
        "Torenstraat"
      ]
    },
    "postbus": {
      "maxLength": 50,
      "examples": [
        "20008"
      ]
    },
    "postcode": {
      "maxLength": 50,
      "examples": [
        "3438TT"
      ]
    },
    "provincie": {
      "pattern": "^https://identifier\\.overheid\\.nl/tooi/id/[^/]+/[^/]+$",
      "examples": [
        "https://identifier.overheid.nl/tooi/id/provincie/pv26"
      ]
    },
    "terAttentieVan": {
      "maxLength": 255,
      "examples": [
        "Burgerzaken"
      ]
    },
    "toelichting": {
      "maxLength": 2048,
      "examples": [
        "Lorem ipsum dolor sit amet, consectetur adipi..."
      ]
    },
    "toevoeging": {
      "maxLength": 250,
      "examples": [
        "Eerste etage"
      ]
    },
    "woonplaats": {
      "maxLength": 2147483647,
      "minLength": 1,
      "examples": [
        "Utrecht"
      ]
    }
  }
}
