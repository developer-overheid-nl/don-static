{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/logius/api-overheidsorganisaties-lmpmj_rdr/errorrecord",
  "x-derived-from": [
    "https://api-organisaties.overheid.nl/v1/openapi.json#/components/schemas/ErrorRecord"
  ],
  "properties": {
    "Error message": {
      "examples": [
        "No organisation found for given identifier(s)"
      ]
    },
    "HTTP status code error": {
      "format": "int32",
      "examples": [
        404
      ]
    },
    "Reason phrase error": {
      "examples": [
        "Not Found"
      ]
    }
  }
}
