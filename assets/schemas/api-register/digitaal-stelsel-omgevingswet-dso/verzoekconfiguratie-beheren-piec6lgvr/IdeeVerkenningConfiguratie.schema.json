{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/verzoekconfiguratie-beheren-piec6lgvr/ideeverkenningconfiguratie",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/232859/verzoekconfiguratie-beheren-v1.json#/components/schemas/IdeeVerkenningConfiguratie"
  ],
  "required": [
    "oin",
    "toegestaan",
    "toelichting"
  ],
  "properties": {
    "oin": {
      "type": "string",
      "pattern": "^\\d{20}$",
      "description": "het OIN van het bevoegd gezag"
    },
    "toegestaan": {
      "type": "boolean",
      "description": "true als ideeverkenning is toegestaan, anders false"
    },
    "toelichting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6144,
      "description": "De toelichting welke in het omgevingsloket getoond kan worden, in MarkDown."
    }
  }
}
