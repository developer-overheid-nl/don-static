{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/opvragen-werkzaamheden-zblce_rdr/werkzaamheidversiehalresponselist",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/239140/toepasbareregels-opvragenwerkzaamheden-v1.json#/components/schemas/WerkzaamheidVersieHALResponseList"
  ],
  "description": "Lijst van werkzaamheid versies met HAL links",
  "required": [
    "_links",
    "page"
  ],
  "properties": {
    "_embedded": {
      "required": [
        "werkzaamheidversies"
      ],
      "properties": {
        "werkzaamheidversies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "description": "Werkzaamheid versie gegevens",
            "required": [
              "urn",
              "omschrijving",
              "beginDatum"
            ],
            "properties": {
              "beginDatum": {
                "description": "Datum in het formaat yyyy-MM-dd",
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "examples": [
                  "2023-01-01"
                ]
              },
              "eindDatum": {
                "description": "Datum in het formaat yyyy-MM-dd",
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "examples": [
                  "2023-01-01"
                ]
              },
              "omschrijving": {
                "description": "Omschrijving van de werkzaamheid versie",
                "type": "string",
                "minLength": 1,
                "maxLength": 250,
                "examples": [
                  "Vellen van een houtopstand"
                ]
              },
              "urn": {
                "description": "Urn van de werkzaamheid",
                "type": "string",
                "pattern": "^\\w{1,100}$",
                "examples": [
                  "BoomKappen"
                ]
              }
            }
          }
        }
      }
    },
    "_links": {
      "description": "Links om te navigeren door de paginering",
      "required": [
        "self",
        "first",
        "last"
      ],
      "properties": {
        "first": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "last": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "next": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "prev": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "self": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        }
      }
    },
    "page": {
      "$ref": "./Page.schema.json"
    }
  }
}
