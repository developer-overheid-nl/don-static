                "description": "Trefwoord van de werkzaamheid versie",
                "type": "string",
                "minLength": 1,
                "maxLength": 250,
                "examples": [
                  "Omhakken"
                ]
              },
              "examples": [
                [
                  "Omhakken",
                  "Boom"
                ]
              ]
