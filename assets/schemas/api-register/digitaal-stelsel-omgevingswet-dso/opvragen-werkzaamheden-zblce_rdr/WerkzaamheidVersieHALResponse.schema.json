          "description": "Datum in het formaat yyyy-MM-dd",
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "examples": [
            "2023-01-01"
          ]
        },
        "eindDatum": {
          "description": "Datum in het formaat yyyy-MM-dd",
