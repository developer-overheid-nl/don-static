          "minLength": 1,
          "maxLength": 250,
          "examples": [
            "Vellen van een houtopstand"
          ]
        },
        "urn": {
          "description": "Urn van de werkzaamheid",
          "type": "string",
          "pattern": "^\\w{1,100}$",
          "examples": [
            "BoomKappen"
          ]
        }
      }
    },
    {
