{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/zoeken-in-activiteiten-voor-indieningsvereisten-en-werkzaamheden-q7gc6lgvr/bestuursorganenperbestuurslaagaggregatie",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/235013/toepasbareregels-zoekinterface-v2.json#/components/schemas/BestuursorganenPerBestuurslaagAggregatie"
  ],
  "description": "De meest voorkomende bestuursorganen in de gevonden activiteiten met het aantal keer dat ze voorkomen. Deze zijn opgedeeld per bestuurslaag.",
  "required": [
    "bestuurslaag",
    "bestuursorganen"
  ],
  "properties": {
    "bestuurslaag": {
      "description": "Bestuurslaag van een Organisatie",
      "type": "string",
      "enum": [
        "rijk",
        "provincie",
        "waterschap",
        "gemeente"
      ]
    },
    "bestuursorganen": {
      "type": "array",
      "items": {
        "description": "Het aantal resultaten per bestuursorgaan",
        "required": [
          "oin",
          "aantal"
        ],
        "properties": {
          "aantal": {
            "type": "number"
          },
          "oin": {
            "description": "Identificatie van een bestuursorgaan.",
            "type": "string",
            "minLength": 20,
            "maxLength": 20
          }
        }
      }
    }
  }
}
