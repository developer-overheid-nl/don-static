{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/verzoeken-indienen-bgk5e_rdg/verzoek",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/162228/verzoeken-indienen-v5.json#/components/schemas/Verzoek",
    "https://service.omgevingswet.overheid.nl/publiek/verzoeken/api/indienen/v5/#/components/schemas/Verzoek"
  ],
  "type": "object",
  "required": [
    "verzoekMetadata",
    "bevoegdGezag",
    "locatie",
    "activiteit"
  ],
  "properties": {
    "activiteit": {
      "description": "Hier bevinden zich alle gegevens omtrent de geselecteerde activiteiten. De algemene set hoort hier ook bij.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "./Activiteit.schema.json"
      }
    },
    "bevoegdGezag": {
      "$ref": "./BevoegdGezag.schema.json"
    },
    "document": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "../_shared/Document.schema.json"
      }
    },
    "locatie": {
      "$ref": "./Locatie.schema.json"
    },
    "rolaanduiding": {
      "$ref": "../_shared/Rolaanduiding.schema.json"
    },
    "verzoekMetadata": {
      "$ref": "../_shared/VerzoekMetadata.schema.json"
    }
  }
}
