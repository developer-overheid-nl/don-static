{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/samengestelde-rtr-services-dgbh6jmvr/bepalenwerkzaamheidcompleetrequest",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/165401/toepasbareregels-samengesteldertrservices-v2.json#/components/schemas/BepalenWerkzaamheidCompleetRequest"
  ],
  "required": [
    "functioneleStructuurRef",
    "_geo"
  ],
  "properties": {
    "_geo": {
      "description": "Filter op geografisch punt of vlak. Zie de [DSO API/URI strategie](https://iplo.nl/digitaal-stelsel/aansluiten/standaarden/api-en-uri-strategie).",
      "required": [
        "intersects"
      ],
      "properties": {
        "intersects": {
          "description": "Punt of vlak waarmee het resultaat raakvlak moet hebben. Analoog aan ElasticSearch GeoShape Query (https://www.elastic.co/guide/en/elasticsearch/reference/5.0/query-dsl-geo-shape-query.html)",
          "oneOf": [
            {
              "$ref": "./Point.schema.json"
            },
            {
              "$ref": "./Polygon.schema.json"
            },
            {
              "$ref": "../_shared/MultiPolygon.schema.json"
            },
            {
              "description": "GeoJSon geometry collection volgens https://tools.ietf.org/html/rfc7946#section-3.1.8",
              "type": "object",
              "required": [
                "geometries",
                "type"
              ],
              "properties": {
                "geometries": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "./Point.schema.json"
                      },
                      {
                        "$ref": "./Polygon.schema.json"
                      },
                      {
                        "$ref": "../_shared/MultiPolygon.schema.json"
                      }
                    ],
                    "minItems": 0
                  }
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "GeometryCollection"
                  ]
                }
              }
            }
          ]
        }
      },
      "examples": [
        {
          "intersects": {
            "type": "Point",
            "coordinates": [
              155000,
              463000
            ]
          }
        }
      ]
    },
    "functioneleStructuurRef": {
      "type": "string",
      "description": "De unieke functionele structuur referentie van een werkzaamheid"
    }
  }
}
