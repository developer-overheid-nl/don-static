{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/omgevingsdocumenten-presenteren-gckm6jmvr/kaartlaagspec",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/omgevingsdocumenten/api/presenteren/v8/openapi.json#/components/schemas/KaartlaagSpec"
  ],
  "title": "Kaartlaag",
  "required": [
    "identificatie",
    "niveau"
  ],
  "type": "object",
  "properties": {
    "identificatie": {
      "type": "string",
      "examples": [
        "nl.imow-gm1979.kaartlaag.20240101"
      ]
    },
    "naam": {
      "type": "string",
      "examples": [
        "Industrieterrein"
      ]
    },
    "niveau": {
      "type": "integer",
      "format": "int32",
      "examples": [
        1
      ]
    }
  }
}
