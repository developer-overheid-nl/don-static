    },
    "groep": {
      "$ref": "./Normgroep.schema.json"
    },
    "identificatie": {
      "type": "string",
      "examples": [
        "nl.imow-gm1911.omgevingsnorm.20240101"
      ]
    },
    "naam": {
      "type": "string",
      "examples": [
        "Bouwhoogte"
      ]
    },
    "normwaarden": {
      "type": "array",
      "items": {
        "$ref": "./Normwaarde.schema.json"
      }
    },
    "symboolcodes": {
      "$ref": "./Symboolcodes.schema.json"
    },
    "type": {
      "$ref": "./TypeNorm.schema.json"
    }
  }
}
