{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/omgevingsdocumenten-presenteren-gckm6jmvr/locatiespec",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/omgevingsdocumenten/api/presenteren/v8/openapi.json#/components/schemas/LocatieSpec"
  ],
  "title": "Locatie",
  "required": [
    "identificatie",
    "locatieType"
  ],
  "type": "object",
  "properties": {
    "geometrieIdentificatie": {
      "type": "string",
      "examples": [
        "4b46ca74-3840-4ce1-91b6-abf749802f6c"
      ]
    },
    "identificatie": {
      "type": "string",
      "examples": [
        "nl.imow-gm1911.gebiedengroep.20240101"
      ]
    },
    "locatieRefs": {
      "title": "LocatieRefs",
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "nl.imow-gm1911.gebied.of.gebiedengroep.20240101"
        ]
      }
    },
    "locatieType": {
      "title": "LocatieType",
      "type": "string",
      "enum": [
        "Gebied",
        "Lijn",
        "Punt",
        "Gebiedengroep",
        "Lijnengroep",
        "Puntengroep",
        "Ambtsgebied"
      ]
    },
    "noemer": {
      "type": "string",
      "examples": [
        "Gemeente Hollands Kroon"
      ]
    }
  }
}
