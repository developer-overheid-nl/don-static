      "examples": [
        "nl.gm19011.juridischeregel.20240101"
      ]
    },
    "instructieregelInstrumenten": {
      "type": "array",
      "items": {
        "$ref": "./Instrument.schema.json"
      }
    },
    "instructieregelTaakuitoefeningen": {
      "type": "array",
      "items": {
        "$ref": "./Adressaat.schema.json"
      }
    },
    "kaartRefs": {
      "title": "KaartRefs",
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "nl.imow-gm1911.kaart.20240101"
        ]
