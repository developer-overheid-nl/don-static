{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/omgevingsdocumenten-verbeelden-ibyvejgdg/symbool",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/omgevingsdocumenten/api/verbeelden/v3/openapi.json#/components/schemas/Symbool"
  ],
  "title": "Symbool",
  "required": [
    "filter",
    "id",
    "layout",
    "paint",
    "source",
    "source-layer",
    "type"
  ],
  "type": "object",
  "properties": {
    "filter": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "id": {
      "type": "string"
    },
    "layout": {
      "$ref": "./Layout.schema.json"
    },
    "niveau": {
      "type": "number",
      "default": 0
    },
    "paint": {
      "$ref": "./Paint.schema.json"
    },
    "source": {
      "type": "string"
    },
    "source-layer": {
      "type": "string",
      "enum": [
        "gebieden",
        "punten",
        "lijnen"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "line",
        "circle",
        "fill",
        "symbol"
      ]
    }
  }
}
