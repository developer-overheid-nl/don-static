{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/crud-rtr-gegevens-g85pejgdr/activiteit",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/167490/toepasbareregels-crud-rtr-gegevens-v2.json#/components/schemas/Activiteit"
  ],
  "required": [
    "urn",
    "omschrijving",
    "bestuursorgaan",
    "locaties",
    "beginDatum",
    "_links"
  ],
  "properties": {
    "_links": {
      "description": "Links naar gerelateerde activiteiten, regelbeheerobjecten en werkzaamheden.",
      "required": [
        "self"
      ],
      "properties": {
        "bovenliggendeActiviteit": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "juridischeRelatiesNaar": {
          "description": "Lijst van HAL links",
          "type": "array",
          "minItems": 0,
          "items": {
            "description": "HAL link",
            "required": [
              "href"
            ],
            "properties": {
              "href": {
                "description": "URI",
                "type": "string"
              }
            }
          }
        },
        "juridischeRelatiesVan": {
          "description": "Lijst van HAL links",
          "type": "array",
          "minItems": 0,
          "items": {
            "description": "HAL link",
            "required": [
              "href"
            ],
            "properties": {
              "href": {
                "description": "URI",
                "type": "string"
              }
            }
          }
        },
        "onderliggendeActiviteiten": {
          "description": "Lijst van HAL links",
          "type": "array",
          "minItems": 0,
          "items": {
            "description": "HAL link",
            "required": [
              "href"
            ],
            "properties": {
              "href": {
                "description": "URI",
                "type": "string"
              }
            }
          }
        },
        "self": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "werkzaamheden": {
          "description": "Lijst van HAL links",
          "type": "array",
          "minItems": 0,
          "items": {
            "description": "HAL link",
            "required": [
              "href"
            ],
            "properties": {
              "href": {
                "description": "URI",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "beginDatum": {
      "description": "Datum in het formaat dd-MM-yyyy.",
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
      "examples": [
        "01-01-2023"
      ]
    },
    "beginDatumToepasbaar": {
      "description": "Datum in het formaat dd-MM-yyyy.",
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
      "examples": [
        "01-01-2023"
      ]
    },
    "bestuursorgaan": {
      "description": "Bestuursorgaan van de activiteit."
    },
    "bevoegdGezag": {
      "description": "Organisatie",
      "required": [
        "bestuurslaag"
      ],
      "properties": {
        "bestuurslaag": {
          "description": "Bestuurslaag van een Organisatie",
          "type": "string",
          "enum": [
            "rijk",
            "provincie",
            "waterschap",
            "gemeente"
          ]
        },
        "oin": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20
        }
      }
    },
    "eindDatum": {
      "description": "Datum in het formaat dd-MM-yyyy.",
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
      "examples": [
        "01-01-2023"
      ]
    },
    "eindDatumToepasbaar": {
      "description": "Datum in het formaat dd-MM-yyyy.",
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
      "examples": [
        "01-01-2023"
      ]
    },
    "locaties": {
      "description": "Locaties waarop deze activiteit geldig is.",
      "type": "array",
      "minItems": 0,
      "items": {
        "required": [
          "identificatie",
          "beginDatum"
        ],
        "properties": {
          "beginDatum": {
            "description": "Datum in het formaat dd-MM-yyyy.",
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
            "examples": [
              "01-01-2023"
            ]
          },
          "eindDatum": {
            "description": "Datum in het formaat dd-MM-yyyy.",
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
            "examples": [
              "01-01-2023"
            ]
          },
          "identificatie": {
            "description": "Unieke imow identificatie van de locatie",
            "type": "string"
          }
        }
      }
    },
    "magneet": {
      "description": "Is de activiteit een magneet activiteit? Als de activiteit niet toepasbaar is gemaakt, wordt dit veld niet teruggegeven.",
      "type": "boolean"
    },
    "omschrijving": {
      "description": "Omschrijving van de activiteit.",
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "regelBeheerObjecten": {
      "description": "Regelbeheerobjecten bij deze activiteit. Als de activiteit niet toepasbaar is gemaakt, wordt dit veld niet teruggegeven.",
      "type": "array",
      "minItems": 0,
      "items": {
        "required": [
          "typering",
          "functioneleStructuurRef"
        ],
        "properties": {
          "functioneleStructuurRef": {
            "description": "De functioneleStructuurRef van het regelbeheerobject.",
            "type": "string"
          },
          "toestemming": {
            "required": [
              "code",
              "waarde"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Code van de toestemming",
                "enum": [
                  "Vergunning",
                  "Melding",
                  "Informatie",
                  "InformatieOngewoonVoorval",
                  "AanvraagMaatwerkvoorschrift",
                  "MeldingGelijkwaardigeMaatregel",
                  "AanvraagToestemmingGelijkwaardigeMaatregel"
                ]
              },
              "waarde": {
                "type": "string",
                "description": "Waarde van het toestemmingstype."
              }
            }
          },
          "typering": {
            "description": "Type regelbeheerobject",
            "type": "string",
            "enum": [
              "Conclusie",
              "Indieningsvereisten",
              "Maatregelen"
            ]
          }
        }
      }
    },
    "toonbaar": {
      "description": "Is de activiteit toonbaar? Als de activiteit niet toepasbaar is gemaakt, wordt dit veld niet teruggegeven.",
      "type": "boolean"
    },
    "typering": {
      "description": "Typering van de activiteit",
      "type": "string",
      "enum": [
        "Water",
        "Milieubelastende",
        "Overige"
      ]
    },
    "urn": {
      "description": "Urn van de activiteit (In de urn mogen geen spaties voorkomen). Binnen de keten staat urn bekend als de imow-id.",
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "verfijnbaar": {
      "deprecated": true,
      "description": "Is de activiteit verfijnbaar? Als de activiteit niet toepasbaar is gemaakt, wordt dit veld niet teruggegeven. Deprecated omdat de verfijnbaar functionaliteit deprecated is.",
      "type": "boolean"
    }
  }
}
