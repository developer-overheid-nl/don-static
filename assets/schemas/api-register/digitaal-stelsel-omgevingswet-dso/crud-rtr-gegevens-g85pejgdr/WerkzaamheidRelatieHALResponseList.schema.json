{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/crud-rtr-gegevens-g85pejgdr/werkzaamheidrelatiehalresponselist",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/167490/toepasbareregels-crud-rtr-gegevens-v2.json#/components/schemas/WerkzaamheidRelatieHALResponseList"
  ],
  "required": [
    "_links",
    "page"
  ],
  "properties": {
    "_embedded": {
      "required": [
        "logischeRelaties"
      ],
      "properties": {
        "logischeRelaties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "required": [
                  "urn"
                ],
                "properties": {
                  "urn": {
                    "type": "string",
                    "description": "Urn van de werkzaamheid",
                    "pattern": "^\\w{1,100}$",
                    "examples": [
                      "BoomKappen"
                    ]
                  }
                }
              },
              {
                "required": [
                  "_links"
                ],
                "properties": {
                  "_links": {
                    "required": [
                      "self",
                      "werkzaamheid"
                    ],
                    "properties": {
                      "self": {
                        "description": "HAL link",
                        "required": [
                          "href"
                        ],
                        "properties": {
                          "href": {
                            "description": "URI",
                            "type": "string"
                          }
                        }
                      },
                      "werkzaamheid": {
                        "description": "HAL link",
                        "required": [
                          "href"
                        ],
                        "properties": {
                          "href": {
                            "description": "URI",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "_links": {
      "description": "Links om te navigeren door de paginering",
      "required": [
        "self",
        "first",
        "last"
      ],
      "properties": {
        "first": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "last": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "next": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "prev": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        },
        "self": {
          "description": "HAL link",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "description": "URI",
              "type": "string"
            }
          }
        }
      }
    },
    "page": {
      "$ref": "../_shared/Page.schema.json"
    }
  }
}
