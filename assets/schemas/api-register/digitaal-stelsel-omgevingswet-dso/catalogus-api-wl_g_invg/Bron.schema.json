{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/catalogus-api-wl_g_invg/bron",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3/openapi.json#/components/schemas/Bron"
  ],
  "required": [
    "begindatumGeldigheid",
    "eigenaar",
    "einddatumGeldigheid",
    "metadata",
    "titel",
    "type",
    "uri",
    "webpagina"
  ],
  "type": "object",
  "properties": {
    "begindatumGeldigheid": {
      "pattern": "^(\\d{4}-[01]\\d-[0-3]\\d)$",
      "type": "string",
      "examples": [
        "2020-04-17"
      ]
    },
    "eigenaar": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "https://standaarden.overheid.nl/owms/terms/Geonovum"
      ]
    },
    "einddatumGeldigheid": {
      "pattern": "^(\\d{4}-[01]\\d-[0-3]\\d)$",
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "2020-04-27"
      ]
    },
    "metadata": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "http://stelselcatalogus.acc.omgevingswet.overheid.nl/doc/20180412000000/dataset/OverbruggingsfunctieRuimtelijkeOrdening"
      ]
    },
    "resource": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "http://data.example.org/Restfull_programming"
      ]
    },
    "titel": {
      "type": "string",
      "examples": [
        "Restfull programming"
      ]
    },
    "type": {
      "type": "string",
      "x-dws-expr": "`http://purl.org/dc/terms/BibliographicResource`",
      "examples": [
        "http://purl.org/dc/terms/BibliographicResource"
      ]
    },
    "uri": {
      "type": "string",
      "examples": [
        "http://stelselcatalogus.omgevingswet.overheid.nl/id/bibliograficresouce/restfull-programming"
      ]
    },
    "webpagina": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "https://en.wikipedia.org/wiki/Representational_state_transfer"
      ]
    }
  }
}
