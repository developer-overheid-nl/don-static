{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/catalogus-api-wl_g_invg/dataset",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3/openapi.json#/components/schemas/Dataset"
  ],
  "type": "object",
  "properties": {
    "distributies": {
      "type": "array",
      "items": {
        "$ref": "./Distributie.schema.json"
      }
    },
    "naam": {
      "type": "string",
      "examples": [
        "Externe Veiligheid"
      ]
    },
    "omgevingsaspecten": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "required": [
          "naam",
          "uri",
          "waardelijstUri"
        ],
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "naam": {
            "type": [
              "string",
              "null"
            ]
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "waardelijstUri": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "uri": {
      "type": "string",
      "examples": [
        "http://standaarden.omgevingswet.overheid.nl/register-externe-veiligheid/id/dataset/Externe%20Veiligheid"
      ]
    }
  }
}
