{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/catalogus-api-wl_g_invg/pageinfo",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3/openapi.json#/components/schemas/PageInfo"
  ],
  "required": [
    "number",
    "size"
  ],
  "type": "object",
  "properties": {
    "number": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int32",
      "x-dws-expr": "`${args.page}`",
      "examples": [
        1
      ]
    },
    "size": {
      "type": "integer",
      "format": "int32",
      "x-dws-expr": "`${args.pageSize}`",
      "examples": [
        10
      ]
    }
  },
  "x-dws-envelope": true
}
