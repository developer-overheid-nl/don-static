{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/catalogus-api-wl_g_invg/next",
  "x-derived-from": [
    "https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3/openapi.json"
  ],
  "required": [
    "href"
  ],
  "type": "object",
  "properties": {
    "href": {
      "type": [
        "string",
        "null"
      ],
      "description": "URL van de link",
      "format": "uri",
      "x-dws-expr": "paging:next(data, args.pageSize, args.host + env.dotwebstack.template.baseUrl, args.requestPathAndQuery)",
      "examples": [
        "https://service.omgevingswet.overheid.nl/publiek/catalogus/api/opvragen/v3/concepten?page=3"
      ]
    }
  },
  "description": "Absolute link naar volgende pagina (null als er geen volgende pagina is)",
  "x-dws-envelope": true
}
