            "geheel onherroepelijk in werking"
          ]
        }
      }
    },
    "id": {
      "type": "string",
      "examples": [
        "NL.IMRO.0200.bp1253-vas1"
      ]
    },
    "naam": {
      "type": "string",
      "examples": [
