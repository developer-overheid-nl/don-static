        "gemeentelijke visie; overig",
        "gerechtelijke uitspraak",
        "inpassingsplan",
        "omgevingsvergunning",
        "projectbesluit",
        "provinciale verordening",
        "reactieve aanwijzing",
        "regeling",
        "rijksbestemmingsplan",
        "structuurvisie",
        "tijdelijke ontheffing buitenplans",
        "uitwerkingsplan",
        "voorbereidingsbesluit",
        "wijzigingsplan"
      ],
      "examples": [
        "bestemmingsplan"
      ]
    }
