{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/ruimtelijke-plannen-api-3zzh61mdr/basefiguur",
  "x-derived-from": [
    "https://ruimte.omgevingswet.overheid.nl/ruimtelijke-plannen/api/opvragen/v4/openapi.json#/components/schemas/BaseFiguur"
  ],
  "required": [
    "_links",
    "artikelnummers",
    "id",
    "illustraties",
    "labelInfo",
    "naam",
    "styleId",
    "verwijzingNaarTekst"
  ],
  "type": "object",
  "properties": {
    "_links": {
      "$ref": "./FunctieaanduidingLinks.schema.json"
    },
    "artikelnummers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "43",
          "23"
        ]
      ]
    },
    "id": {
      "type": "string",
      "examples": [
        "NL.IMRO.0200.ID387926-00"
      ]
    },
    "illustratie": {
      "required": [
        "href",
        "legendanaam",
        "naam",
        "type"
      ],
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "href": {
          "type": "string",
          "examples": [
            "https://ruimtelijkeplannen.nl/documents/NL.IMRO.0200.sv1002-vas1/i_NL.IMRO.0200.sv1002-vas1_1.pdf"
          ]
        },
        "legendanaam": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "Beleidskaart"
          ]
        },
        "naam": {
          "type": [
            "string",
            "null"
          ],
          "examples": [
            "Regionale Structuurvisie Stedendriehoek 2030"
          ]
        },
        "type": {
          "type": "string",
          "examples": [
            "kaart"
          ]
        }
      }
    },
    "labelInfo": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "hoogspanningsverbinding"
      ]
    },
    "naam": {
      "type": "string",
      "examples": [
        "hartlijn leiding - hoogspanningsverbinding"
      ]
    },
    "styleId": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "dubbelbestemming_waterstaat"
      ]
    },
    "verwijzingNaarTekst": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "https://www.ruimtelijkeplannen.nl/historic/NL.IMRO.0200.bp1002-ont1_2019.01.10_14.54.32/i_NL.IMRO.0200.bp1002-ont1_0001.jpg"
        ]
      }
    }
  }
}
