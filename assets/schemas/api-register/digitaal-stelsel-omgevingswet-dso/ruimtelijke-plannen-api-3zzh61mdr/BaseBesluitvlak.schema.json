{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/ruimtelijke-plannen-api-3zzh61mdr/basebesluitvlak",
  "x-derived-from": [
    "https://ruimte.omgevingswet.overheid.nl/ruimtelijke-plannen/api/opvragen/v4/openapi.json#/components/schemas/BaseBesluitvlak"
  ],
  "required": [
    "_links",
    "cartografieInfo",
    "id",
    "illustraties",
    "naam",
    "styleId",
    "thema",
    "verwijzingNaarTekst"
  ],
  "type": "object",
  "properties": {
    "_links": {
      "$ref": "./BesluitvlakLinks.schema.json"
    },
    "cartografieInfo": {
      "type": "array",
      "items": {
        "$ref": "./CartografieInfo.schema.json"
      }
    },
    "id": {
      "type": "string",
      "examples": [
        "NL.IMRO.3"
      ]
    },
    "illustraties": {
      "type": "array",
      "items": {
        "$ref": "./IllustratieReferentie.schema.json"
      }
    },
    "naam": {
      "type": "string",
      "examples": [
        "Besluitvlak omgevingsvergunning"
      ]
    },
    "styleId": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "dubbelbestemming_waterstaat"
      ]
    },
    "thema": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "energie"
        ]
      }
    },
    "verwijzingNaarTekst": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "https://ruimtelijkeplannen.nl/documents/NL.IMRO.0200.ov1015-vas1/b_NL.IMRO.0200.ov1015-vas1.pdf"
        ]
      }
    }
  }
}
