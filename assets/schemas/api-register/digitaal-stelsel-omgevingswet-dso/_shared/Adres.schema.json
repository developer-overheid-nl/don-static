{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/digitaal-stelsel-omgevingswet-dso/_shared/adres",
  "x-derived-from": [
    "https://developer.omgevingswet.overheid.nl/publish/pages/162228/verzoeken-indienen-v5.json#/components/schemas/Adres",
    "https://service.omgevingswet.overheid.nl/publiek/verzoeken/api/indienen/v5/#/components/schemas/Adres"
  ],
  "type": "object",
  "required": [
    "nummeraanduidingId",
    "straat",
    "nummer",
    "woonplaats"
  ],
  "properties": {
    "letter": {
      "type": "string",
      "pattern": "^[A-Za-z]{1}$"
    },
    "nummer": {
      "type": "string",
      "pattern": "^[0-9]{1,5}$"
    },
    "nummeraanduidingId": {
      "type": "string",
      "pattern": "^[0-9]{16}$"
    },
    "postcode": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}\\s?[A-Za-z]{2}$"
    },
    "straat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "toevoeging": {
      "type": "string",
      "pattern": "^.{1,4}$"
    },
    "woonplaats": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  }
}
