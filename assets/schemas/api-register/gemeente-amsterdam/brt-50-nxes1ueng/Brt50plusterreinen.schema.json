{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/gemeente-amsterdam/brt-50-nxes1ueng/brt50plusterreinen",
  "x-derived-from": [
    "https://api.data.amsterdam.nl/v1/brt50/openapi.json#/components/schemas/Brt50plusterreinen"
  ],
  "type": "object",
  "description": "Amsterdamse plusinformatie: terreinen.",
  "properties": {
    "_links": {
      "title": " links",
      "type": "object",
      "description": "The contents of the `plusterreinen._links` field. It contains all relationships with objects.",
      "properties": {
        "schema": {
          "type": "string",
          "format": "uri",
          "description": "The schema field is exposed with every record",
          "readOnly": true
        },
        "self": {
          "$ref": "./Brt50plusterreinenLink.schema.json"
        }
      },
      "required": [
        "schema",
        "self"
      ]
    },
    "geometrie": {
      "$ref": "../_shared/Geometry.schema.json"
    },
    "geometrieVlak": {
      "type": "object",
      "description": "GeoJSON geometry",
      "allOf": [
        {
          "$ref": "../_shared/Geometry.schema.json"
        },
        {
          "properties": {
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "description": "Point in 3D space",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "Polygon"
              ]
            }
          }
        }
      ]
    },
    "identificatie": {
      "type": "string",
      "title": "Plus Object ID",
      "description": "De identiteit van het geo-object; in dit geval een 'teller'."
    },
    "type": {
      "type": [
        "string",
        "null"
      ],
      "title": "Gebied type",
      "description": "Het soort terrein."
    }
  },
  "required": [
    "_links",
    "identificatie"
  ]
}
