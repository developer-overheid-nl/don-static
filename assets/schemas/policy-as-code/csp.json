{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",

  "properties": {
    "defaultSrc": { "$ref": "#/$defs/sourceList" },
    "scriptSrc": { "$ref": "#/$defs/sourceList" },
    "styleSrc": { "$ref": "#/$defs/sourceList" },
    "imgSrc": { "$ref": "#/$defs/sourceList" },
    "connectSrc": { "$ref": "#/$defs/sourceList" },
    "fontSrc": { "$ref": "#/$defs/sourceList" },
    "objectSrc": { "$ref": "#/$defs/sourceList" },
    "mediaSrc": { "$ref": "#/$defs/sourceList" },
    "frameSrc": { "$ref": "#/$defs/sourceList" },

    "baseUri": { "$ref": "#/$defs/sourceList" },
    "formAction": { "$ref": "#/$defs/sourceList" },
    "frameAncestors": { "$ref": "#/$defs/sourceList" },

    "scriptSrcElem": { "$ref": "#/$defs/sourceList" },
    "scriptSrcAttr": { "$ref": "#/$defs/sourceList" },
    "styleSrcElem": { "$ref": "#/$defs/sourceList" },
    "styleSrcAttr": { "$ref": "#/$defs/sourceList" },

    "upgradeInsecureRequests": {
      "type": "boolean",
      "default": false
    },
    "blockAllMixedContent": {
      "type": "boolean",
      "default": false
    },

    "requireTrustedTypesFor": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["script"]
      }
    },

    "trustedTypes": {
      "type": "array",
      "items": { "type": "string" }
    },

    "reportUri": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },

    "reportTo": {
      "type": "string"
    }
  },

  "additionalProperties": false,

  "$defs": {
    "sourceList": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "enum": ["'self'", "'none'", "'unsafe-inline'", "'unsafe-eval'"] },
          { "type": "string", "format": "uri" },
          { "type": "string", "pattern": "^https?:\\/\\/.*" },
          { "type": "string", "pattern": "^\\*\\..*" },
          { "type": "string", "pattern": "^'nonce-.*'$" },
          { "type": "string", "pattern": "^'sha256-.*'$" },
          { "type": "string", "pattern": "^'sha384-.*'$" },
          { "type": "string", "pattern": "^'sha512-.*'$" }
        ]
      }
    }
  }
}
