{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brouwerij",
  "description": "De brouwerij, inclusief naam, grootte en adres",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unieke identifier",
      "examples": ["046b6c7f-0b8a-43b9-b35d-6489e6daee93"]
    },
    "naam": {
      "type": "string",
      "description": "Naam",
      "examples": ["Brouwtoren"]
    },
    "grootte": {
      "type": "string",
      "enum": ["hobby", "micro", "groot"],
      "description": "Grootte brouwerij (hobby/micro/groot)",
      "examples": ["micro"]
    },
    "adres": {
      "$ref": "./Adres.schema.json"
    }
  },
  "required": ["id", "naam", "grootte"],
  "additionalProperties": false
}